<%
  const b = broker;
  const name = (b.full_name || '').trim();
  const first = name.split(/\s+/)[0];
  const company = (b.company_name || '').trim();
  const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();
  const areas = (b.areas || []).filter(Boolean);
  const city = (b.city || 'Bangalore').trim();
  const since = b.member_since ? new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(new Date(b.member_since)) : null;
  const sinceYear = b.member_since ? new Date(b.member_since).getFullYear() : null;
  const rating = b.rating ? Number(b.rating) : null;
  const digits = String(b.phone_no || '').replace(/\D/g, '');
  const wa = digits ? (digits.length === 10 ? '91' + digits : digits) : null;
  const bio = (b.bio || '').trim();
  const desc = (bio || `${name} is a verified real estate broker${company ? ' at ' + company : ''} in ${city}${areas.length ? ', working in ' + areas.slice(0, 3).join(', ') : ''}.`).replace(/\s+/g, ' ').slice(0, 155);
  const title = `${name}${company ? ' — ' + company : ''} | Real estate broker in ${city} | RealBroker`;
  const isHttp = (u) => typeof u === 'string' && u.startsWith('http');
  const photo = (p) => (p.images || []).find(i => isHttp(i) && !i.startsWith('https://placehold.co/'));
  const price = (p) => {
    const v = Number(p.price); if (!v) return 'Price on request';
    if (v >= 1e7) return '₹ ' + (v / 1e7).toFixed(2).replace(/\.00$/, '') + ' Cr';
    if (v >= 1e5) return '₹ ' + (v / 1e5).toFixed(2).replace(/\.00$/, '') + ' L';
    return '₹ ' + new Intl.NumberFormat('en-IN').format(v);
  };
  const listings = b.properties || [];
  const shown = listings.slice(0, 6);
  const ld = [{
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    name,
    url: b.page_url,
    image: isHttp(b.avatar_url) ? b.avatar_url : undefined,
    description: bio || undefined,
    worksFor: company ? { '@type': 'Organization', name: company } : undefined,
    address: { '@type': 'PostalAddress', addressLocality: city, addressRegion: 'Karnataka', addressCountry: 'IN' },
    areaServed: areas.length ? areas.map(a => ({ '@type': 'Place', name: `${a}, ${city}` })) : city,
    telephone: digits ? '+' + (digits.length === 10 ? '91' + digits : digits) : undefined,
    memberOf: { '@type': 'Organization', name: 'RealBroker', url: b.site_url },
  }, {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: b.site_url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Members', item: b.site_url + '/members' },
      { '@type': 'ListItem', position: 3, name: city, item: b.site_url + b.city_url },
      { '@type': 'ListItem', position: 4, name, item: b.page_url },
    ],
  }];
  const json = (o) => JSON.stringify(o).replace(/</g, '\\u003c');
  const ICON = {
    phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>',
    wa: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg>',
    plus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>',
    mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>',
    web: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>',
  };
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= desc %>">
  <link rel="canonical" href="<%= b.page_url %>">
  <meta property="og:type" content="profile">
  <meta property="og:url" content="<%= b.page_url %>">
  <meta property="og:title" content="<%= name %><%= company ? ' — ' + company : '' %>">
  <meta property="og:description" content="<%= desc %>">
  <% if (isHttp(b.avatar_url)) { %><meta property="og:image" content="<%= b.avatar_url %>"><% } %>
  <meta name="twitter:card" content="summary">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/static-pages.css">
  <script type="application/ld+json"><%- json(ld) %></script>
</head>
<body>
  <header class="nav"><div class="nav-in">
    <a href="/" aria-label="RealBroker home"><img src="/rb-logo.jpg" alt="RealBroker" width="43" height="32"></a>
    <nav class="nav-links" aria-label="Main"><a href="/members" class="on">Members</a><a href="/product">Product</a><a href="/agreements">Agreements</a></nav>
    <div class="nav-act"><a class="login" href="<%= b.app_url %>/login">Log in</a><a class="btn red sm" href="<%= b.app_url %>/request-invite">Request an invite</a></div>
  </div></header>

  <main class="wrap">
    <p class="crumbs"><a href="/">Home</a> › <a href="/members">Members</a> › <a href="<%= b.city_url %>"><%= city %></a> › <%= name %></p>
    <div class="layout">
      <div>
        <section class="card top">
          <div class="cover"<% if (isHttp(b.cover_image)) { %> style="background-image:url('<%= b.cover_image %>')"<% } %>></div>
          <div class="top-body">
            <div class="pav"><% if (isHttp(b.avatar_url)) { %><img src="<%= b.avatar_url %>" alt="<%= name %>" width="152" height="152"><% } else { %><%= initials %><% } %></div>
            <div class="head">
              <div>
                <h1><%= name %></h1>
                <div class="headline"><%= company ? company + ' · ' : '' %>Real estate broker</div>
                <div class="meta"><%= city %><%= since ? ' · Member since ' + since : '' %></div>
                <div class="meta2"><% if (rating) { %>★ <b><%= rating.toFixed(1) %></b> · <% } %><b><%= listings.length %> <%= listings.length === 1 ? 'listing' : 'listings' %></b><%= areas.length ? ' · ' + areas.length + (areas.length === 1 ? ' area' : ' areas') : '' %></div>
              </div>
              <div class="affs">
                <% if (company) { %><div class="aff"><% if (isHttp(b.company_logo_url)) { %><img src="<%= b.company_logo_url %>" alt=""><% } else { %><span class="logo"><%= company.slice(0, 2).toUpperCase() %></span><% } %><%= company %></div><% } %>
                <div class="aff"><span class="logo" style="color:#2E7D32;background:#EAF5EC">✓</span>Verified RealBroker member</div>
              </div>
            </div>
            <div class="actions">
              <% if (digits) { %><a class="btn red sm" href="tel:+<%= wa %>"><%- ICON.phone %>Call</a>
              <a class="btn out sm" href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent('Hi ' + first + ', I found your profile on RealBroker.') %>" target="_blank" rel="noopener"><%- ICON.wa %>WhatsApp</a><% } %>
              <a class="btn out sm" href="<%= b.app_url %>/<%= b.vanity_url || '' %>"><%- ICON.plus %>Connect</a>
            </div>
            <p class="hint">Brokers: log in to connect with <%= first %> on RealBroker.</p>
          </div>
        </section>

        <section class="card sec">
          <h2>About</h2>
          <p class="bio"><%= bio || `${name} is a verified real estate broker${company ? ' at ' + company : ''} in ${city}.` %></p>
          <% if (areas.length) { %>
            <h3 class="sub-h">Areas of expertise</h3>
            <div class="pills"><% areas.forEach(a => { %><span><%= a %></span><% }) %></div>
          <% } %>
        </section>

        <% if (listings.length) { %>
        <section class="card sec">
          <h2>Listings <span style="color:#666;font-weight:500">(<%= listings.length %>)</span></h2>
          <div class="lgrid">
            <% shown.forEach(p => { const img = photo(p); const rent = p.property_type === 'Rent'; const href = isHttp(p.static_html_url) ? p.static_html_url : null; %>
              <<%= href ? 'a' : 'div' %> class="lcard"<% if (href) { %> href="<%= href %>" target="_blank" rel="noopener"<% } %>>
                <div class="lph"><span class="ltag"><%= rent ? 'For rent' : 'For sale' %></span><% if (img) { %><img src="<%= img %>" alt="<%= p.title %>" loading="lazy"><% } else { %>Photos coming soon<% } %></div>
                <div class="lbody">
                  <div class="lprice"><%= price(p) %><% if (rent && Number(p.price)) { %> <small>/month</small><% } %></div>
                  <div class="ltitle"><%= p.title %></div>
                  <div class="lmeta"><%= [p.bedrooms ? p.bedrooms + ' BHK' : '', p.baths ? p.baths + ' bath' : '', p.sqft ? new Intl.NumberFormat('en-IN').format(p.sqft) + ' sq.ft' : ''].filter(Boolean).join(' · ') %></div>
                  <% if (p.area) { %><div class="lmeta"><%= p.area %>, <%= city %></div><% } %>
                </div>
              </<%= href ? 'a' : 'div' %>>
            <% }) %>
          </div>
          <% if (listings.length > shown.length) { %><a class="btn ghost more" href="<%= b.app_url %>/<%= b.vanity_url || '' %>">See all <%= listings.length %> listings on RealBroker</a><% } %>
        </section>
        <% } %>
      </div>

      <aside class="side">
        <div class="card">
          <h3>At a glance</h3>
          <div class="stats">
            <div class="stat"><b><%= listings.length %></b><span>Active listings</span></div>
            <div class="stat"><b><%= areas.length || '—' %></b><span>Areas served</span></div>
            <div class="stat"><b><%= rating ? rating.toFixed(1) : '—' %></b><span>Rating</span></div>
            <div class="stat"><b><%= sinceYear || '—' %></b><span>Member since</span></div>
          </div>
        </div>
        <% if (digits || b.email || b.website) { %>
        <div class="card">
          <h3>Contact</h3>
          <% if (digits) { %><a class="crow" href="tel:+<%= wa %>"><%- ICON.phone %><span><small>Phone</small>+<%= wa.replace(/^91(\d{5})(\d{5})$/, '91 $1 $2') %></span></a><% } %>
          <% if (b.email) { %><a class="crow" href="mailto:<%= b.email %>"><%- ICON.mail %><span><small>Email</small><%= b.email %></span></a><% } %>
          <% if (b.website) { %><a class="crow" href="<%= b.website.startsWith('http') ? b.website : 'https://' + b.website %>" target="_blank" rel="noopener"><%- ICON.web %><span><small>Website</small><%= b.website.replace(/^https?:\/\//, '') %></span></a><% } %>
        </div>
        <% } %>
        <% if ((b.nearby || []).length) { %>
        <div class="card">
          <h3>Brokers in the same areas</h3>
          <% b.nearby.forEach(n => { %>
            <a class="srow" href="<%= n.url %>"><span class="face"><% if (n.avatar) { %><img src="<%= n.avatar %>" alt="" loading="lazy"><% } else { %><%= n.name.split(/\s+/).slice(0, 2).map(w => w[0]).join('').toUpperCase() %><% } %></span><span><b style="font-size:14px"><%= n.name %></b><small><%= n.company %><%= n.area ? ' · ' + n.area : '' %></small></span></a>
          <% }) %>
          <a class="link" href="<%= b.city_url %>" style="display:block;margin-top:8px;font-size:14px">All brokers in <%= city %> ›</a>
        </div>
        <% } %>
        <div class="card dark">
          <b style="font-size:16px">Broker in <%= city %>?</b>
          <p>Get a profile like this and search 50,000+ broker listings.</p>
          <a class="btn red sm" style="width:100%" href="<%= b.app_url %>/request-invite">Request an invite</a>
        </div>
      </aside>
    </div>
  </main>

  <footer class="foot"><div class="wrap">
    <div class="foot-in">
      <a href="/"><img src="/rb-logo.jpg" alt="RealBroker" style="height:26px;width:auto"></a>
      <nav aria-label="Footer"><a href="/members">Members</a><a href="/product">Product</a><a href="/agreements">Agreements</a><a href="/charter-and-conduct">Code of conduct</a><a href="/privacy">Privacy</a></nav>
    </div>
    <small>© <%= new Date().getFullYear() %> RealBroker · The private network for Bangalore’s verified brokers</small>
  </div></footer>
</body>
</html>
